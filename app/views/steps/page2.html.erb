      <button class="preview button blue">Preview Dekhlo</button>
      <button class="edit button red" style="display: none;">Edit Preview</button>
      <button class="final-preview button green" style="display: none; float: right;">PRINT PAGE</button>
      <script>
         $(document).ready(function(){	
                     $('.add').on('click', add);
                     $('.remove').on('click', remove);
                 
                 function add() {
                     var new_chq_no = parseInt($('#total_chq').val()) + 1;
                     var new_input = "<input type='text' id='new_" + new_chq_no + "'><br/>";
                 var  new_input = "<p style='margin-top:0.05in;margin-right:0in;margin-bottom:.0001pt;margin-left:0.5in;line-height:115%;font-family:'Calibri','sans-serif';text-indent:.5in;'><strong><span style='line-height:115%;color:#222222;background:white;'><span class='input-new'><strng><input type='text' class='testing ka-naam-ankit' id='new_" + new_chq_no + "'></strong><span></span></strong><span style='font-family:'Arial','sans-serif';color:#222222;background:white;'>&nbsp;</span></p>"
                     $('#new_chq').append(new_input);
                     
                     $('#total_chq').val(new_chq_no);
                 }
                 
                 function remove() {
                     var last_chq_no = $('#total_chq').val();
                 
                     if (last_chq_no > 1) {
                     $('#new_' + last_chq_no).remove();
                     $('#total_chq').val(last_chq_no - 1);
                     }
                 }
                 
                 $('.preview').on('click', function(){
                     $('form').submit(false);
                     $('.add').hide()
                     $('.remove').hide()
                     $('.testing').each(function( index, ele ) {
                        var valu = $(ele).val().replace(/^\s+|\s+$/gm,'');
                        if($(ele).hasClass('dinank') || $(ele).hasClass('dinank1')){
                          var formatter = new Intl.DateTimeFormat('en-UK', { day: '2-digit', month: '2-digit', year: 'numeric' });
                          var newDate = new Date(valu);
                          var formattedDate = formatter.format(newDate);
                          valu = formattedDate;
                        }
                         var paret = $(ele).parent().parent()
                         paret.append("<span style='line-height:115%;font-family:&quot;Kruti Dev 010;' class='testing-valu'>"+ valu +"</span>")
                         $(ele).hide()    
                     });
                 
                     if($('.tal').val() === ''){
                         $('#tal').remove()
                     }
                     if($('.prathm').val() === ''){
                         $('#prathm').remove()
                     }
                     if($('.divitiya').val() === ''){
                         $('#divitiya').remove()
                     }
                     if($('.tritiya').val() === ''){
                         $('#tritiya').remove()
                     }
                     if($('.other').val() === ''){
                     $('#other').remove()
                     }
                     
                     var checkBox = $("#newAccountCheck");
                     if (checkBox.is(":checked")){
                     $('.new-account-label').show()
                     checkBox.hide();
                     } else {
                     $('.new-account-label').hide()
                     checkBox.hide();
                     }
                     $(this).hide()
                     $('.edit').show()
                     $('.final-preview').show()
                 })
         
                 $('.edit').on('click', function(){
                     $('form').submit(false);
                     $('.preview').show();
                     $('.testing-valu').remove()
                     $('.testing').show()
                     $(this).hide()
                     $('.final-preview').hide()
                     $('.add').show()
                     $('.remove').show()
                     $("#newAccountCheck").show();
                     $('.new-account-label').show();
                 });
                 
                 $('.flat-no').on('blur', function(){
                     $('.flat-no1').val($(this).val())
                     $('.flat-no2').val($(this).val())
                 })
                 
                 $('.mohalla').on('blur', function(){
                     $('.mohalla1').val($(this).val())
                     $('.mohalla2').val(`, ${$(this).val()}`)
                 })
                 
                 $('.pavati').on('blur', function(){
                     $('.pavati1').val($(this).val())
                 })
                 
                 $('.c-pavati').on('blur', function(){
                     $('.c-pavati1').val($(this).val())
                 })
         
                 $('.dinank').on('blur', function(){
                     $('.dinank1').val($(this).val())
                 })
                 
                 
                 $('.book').on('blur', function(){
                     $('.book1').val($(this).val())
                 })
                 
                 $('#new_chq').on('blur', '.ka-naam-ankit', function(){
                     var kaNaamAnkit = []
                     $("#new_chq .ka-naam-ankit").each(function() {
                         kaNaamAnkit.push($(this).val());
                     });
                     $('#ka-naam-ankit1').val(kaNaamAnkit.join(", "))
                 })
                 })
         
                 $('.final-preview').on('click', function(){
                     $('.edit').hide()
                     $('.preview').hide()
                     $('.continue-action').hide()
                     $(this).hide()
                     $('.logout').hide()
                     window.print()
                 });
         
                 $('#newAccountCheck').on('click', function(){
                     if ($(this).is(":checked")){
                     $('.flat2-mohalla2').show()
                     $('.no-flat2-mohalla2').hide()
                     $('#new_account').val(true);
                     } else {
                     $('.flat2-mohalla2').hide()
                     $('.no-flat2-mohalla2').show()
                     $('#new_account').val(false);
                     }
                 });
      </script>
