<!DOCTYPE html>
<html>
  <head>
    <title></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/jquery.dataTables.min.css">
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
  </head>

  <body>
    <div>
      <p style="margin-top:0.05in;margin-right:0in;margin-bottom:10.0pt;margin-left:0in;line-height:115%;">
        <a href="<%= namantarans_path %>">
          <button class="edit button green" style="float: right;">Listing</button>
        </a>
        <% if @namantaran.present? %>
          <% ['page1', 'page2', 'page3', 'page4'].each do |page| %>  
            <% unless page.eql?(params[:id]) %> 
              <a href="<%= namantaran_step_path(@namantaran, page) %>">
                <button class="edit button green" style="float: right;"><%= page %></button>
              </a>
            <% end %>  
          <% end %>  
        <% end %>
      </p>
    </div>
  
    <div style='display: inline-block;'>
      <%= yield %>
    </div>  
  </body>
</html>
