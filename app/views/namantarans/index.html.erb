<% if current_user.admin %>
<h1>Copy Namantaran</h1>
<%= form_with url: copy_namantaran_namantarans_path, method: :post do |f| %>
  <div class="field">
    <%= f.label :copy_no %>
    <%= f.number_field :copy_no, required: true %>
  </div>

  <div class="field">
    <%= f.label :id %>
    <%= f.number_field :id, required: true %>
  </div>

  <div class="actions">
    <%= f.submit "Submit" %>
  </div>
<% end %>
<% end %>

<script>
$(document).ready( function () {
  $('.namantaran1s').DataTable();
});    
</script>



