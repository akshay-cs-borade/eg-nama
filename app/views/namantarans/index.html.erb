<h1>Namantarans</h1>

<div>
  <%= button_to "Add New", { action: "create" }, class: "edit button blue" %>
</div> 
<br/> 
 

<div id="namantaran1s">
  <table class='namantaran1s'>#
    <thead>
      <tr>
        <th><span style="line-height:115%;font-family:&quot;Kruti Dev 010&quot;;">ua-&nbsp;</span></th>
        <th><span style="line-height:115%;font-family:&quot;Kruti Dev 010&quot;;">&nbsp;% IykV@edkua@¶ySV ua-&nbsp;</span></th>
        <th><span style="line-height:115%;font-family:&quot;Kruti Dev 010&quot;;">&nbsp;lfoZl ua-@fiu ua-&nbsp;</span></th>
        <th><span style="font-family:&quot;Kruti Dev 010&quot;;">dk uke vafdr fd;k x;k gSA</span></th>
        <th><span style="line-height:115%;">author</span></th>
        <th><span style="line-height:115%;">Date</span></th>
        <th>Action</th>
      </tr>
    </thead>
    <tbody>
      <% @namantarans.each_with_index do |namantaran, i| %>
        <%= render partial: namantaran, locals: { page_no: i+1 } %>
      <% end %>
    </tbody>
  </table>
